# ---------------------------------------------------------------------------
# Savr backend environment configuration.
#
# Copy this file to ".env"  (e.g.  cp .env.example .env)  and edit as needed.
# The backend runs with sensible defaults, so it works without editing anything.
# ".env" is git-ignored — never commit real secrets or API keys.
# ---------------------------------------------------------------------------

# Secret used to sign login (JWT) tokens. Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login token stays valid (e.g. 1d, 12h, 3600s). Default: 1d
JWT_EXPIRES_IN=1d

# Port the backend listens on. Default: 4000
PORT=4000

# ---------------------------------------------------------------------------
# Image Service — Google Custom Search API (OPTIONAL)
#
# No configuration is required: if these are left blank, ingredient image
# search automatically uses built-in local image suggestions
# (the response reports provider: "fallback"), so the app is fully usable.
#
# Fill in BOTH values to enable live Google web-image search
# (the response reports provider: "google"):
#   GOOGLE_SEARCH_API_KEY   - API key from Google Cloud ("Custom Search API" enabled)
#   GOOGLE_SEARCH_ENGINE_ID - Programmable Search Engine ID (cx), with Image search on
# ---------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# How long (ms) to cache Google image results in memory. Default: 600000 (10 min)
IMAGE_SEARCH_CACHE_TTL_MS=600000

# ---------------------------------------------------------------------------
# Advanced / testing (OPTIONAL — leave unset for normal use)
# ---------------------------------------------------------------------------

# Override the SQLite database file path. Defaults to the committed v3.0 database.
# The automated tests set this to a throwaway copy so they never touch real data.
# SAVR_DB_PATH=
